{
  "name": "@allllll703/midi",
  "version": "0.1.0",
  "description": "A secure MCP server for MuScriptor audio-to-MIDI transcription",
  "type": "module",
  "bin": {
    "midi": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "audio-to-midi",
    "mcp",
    "model-context-protocol",
    "muscriptor",
    "music-transcription"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ALLLLLL703/midi.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ipaddr.js": "^2.2.0",
    "midi-file": "^1.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
